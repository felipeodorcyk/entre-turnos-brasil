/assets/*
  Cache-Control: public, max-age=31536000, immutable
/release/:id/*
  Cache-Control: public, max-age=31536000, immutable
/release/current.json
  ! Cache-Control
  Cache-Control: no-cache
/context/*
  Cache-Control: public, max-age=31536000, immutable
/geo/*
  Cache-Control: public, max-age=86400
/geo/*.geojson
  Content-Type: application/json
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

