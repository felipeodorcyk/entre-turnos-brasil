{
  "name": "presidenciais-2026-web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:oracle": "vitest run src/engine/oracle.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "export": "cd .. && .venv/Scripts/python.exe tools/web_export/export_web_release.py",
    "oracle": "cd .. && .venv/Scripts/python.exe tools/web_export/oracle.py"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "30.1.3",
    "playwright": "^1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
