{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrato de tabela br2026 v1",
  "type": "object",
  "required": [
    "table",
    "version",
    "owner",
    "path",
    "granularity",
    "primary_key",
    "columns"
  ],
  "properties": {
    "table": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "version": {
      "const": "1.2.0"
    },
    "owner": {
      "enum": [
        "A",
        "B"
      ]
    },
    "path": {
      "type": "string"
    },
    "granularity": {
      "type": "string"
    },
    "primary_key": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "name",
              "type",
              "nullable"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "type": {
                "enum": [
                  "string",
                  "int8",
                  "int16",
                  "int32",
                  "int64",
                  "float64",
                  "bool",
                  "date",
                  "timestamp_tz"
                ]
              },
              "nullable": {
                "type": "boolean"
              },
              "enum": {
                "type": "array"
              },
              "pattern": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
